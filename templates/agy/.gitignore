# templates/agy — local artifacts.

# Persistent agent state: auth tokens, history, config. Never commit.
state/*
!state/.gitkeep

# Default workspace dir (used when WORKSPACE points here).
workspace/*
!workspace/.gitkeep

# Local environment with potentially-sensitive values.
.env

# Ignore the agy binary that users need to download/copy manually
bin/*
!bin/.gitkeep
